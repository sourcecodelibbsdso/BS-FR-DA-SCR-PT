import java.awt.*;
import java.awt.event.*;
import java.awt.image.BufferedImage;
import java.util.ArrayList;
import java.util.List;
import javax.swing.*;

public class BrawlESP extends JFrame {

    // ── CONFIG ──────────────────────────────────────────────────────────────
    static final int SCREEN_W = (int) Toolkit.getDefaultToolkit().getScreenSize().getWidth();
    static final int SCREEN_H = (int) Toolkit.getDefaultToolkit().getScreenSize().getHeight();
    static final int CENTER_X = SCREEN_W / 2;
    static final int CENTER_Y = SCREEN_H / 2;

    // Enemy detection color (RGB) — health bar red
    static final int ENEMY_R_MIN = 180, ENEMY_R_MAX = 255;
    static final int ENEMY_G_MIN = 0,   ENEMY_G_MAX = 80;
    static final int ENEMY_B_MIN = 0,   ENEMY_B_MAX = 80;

    // ESP Box config
    static final int BOX_W      = 40;
    static final int BOX_H      = 60;
    static final int SCAN_STEP  = 3;   // pixel step — lower = more accurate, more CPU

    static volatile boolean espActive = false;
    static Robot robot;
    static List<int[]> enemies = new ArrayList<>();
    // ────────────────────────────────────────────────────────────────────────

    // Overlay panel
    JPanel overlay;

    public BrawlESP() throws AWTException {
        robot = new Robot();

        setTitle("sourcecodelibbsd.so — ESP");
        setUndecorated(true);
        setAlwaysOnTop(true);
        setBackground(new Color(0, 0, 0, 0));
        setSize(SCREEN_W, SCREEN_H);
        setLocation(0, 0);
        setDefaultCloseOperation(EXIT_ON_CLOSE);

        // Click-through: overlay doesn't consume mouse events
        AWTUtilities_setWindowOpaque(this);

        overlay = new JPanel() {
            @Override
            protected void paintComponent(Graphics g) {
                super.paintComponent(g);
                setOpaque(false);
                Graphics2D g2 = (Graphics2D) g;
                g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING,
                                    RenderingHints.VALUE_ANTIALIAS_ON);
                drawESP(g2);
            }
        };
        overlay.setOpaque(false);
        add(overlay);
        setVisible(true);

        // Scan thread
        new Thread(this::scanLoop, "esp-scan").start();

        // Repaint thread
        new Thread(() -> {
            while (true) {
                overlay.repaint();
                try { Thread.sleep(16); } catch (InterruptedException ignored) {}
            }
        }, "esp-render").start();
    }

    // ── SCAN ────────────────────────────────────────────────────────────────

    void scanLoop() {
        while (true) {
            if (!espActive) {
                try { Thread.sleep(50); } catch (InterruptedException ignored) {}
                continue;
            }

            try {
                BufferedImage frame = robot.createScreenCapture(
                        new Rectangle(0, 0, SCREEN_W, SCREEN_H));

                List<int[]> found = new ArrayList<>();

                for (int x = 0; x < SCREEN_W; x += SCAN_STEP) {
                    for (int y = 0; y < SCREEN_H; y += SCAN_STEP) {
                        Color c = new Color(frame.getRGB(x, y));
                        if (isEnemyColor(c)) {
                            // Cluster merge — skip if already near a found point
                            boolean merged = false;
                            for (int[] e : found) {
                                if (Math.abs(e[0] - x) < BOX_W && Math.abs(e[1] - y) < BOX_H) {
                                    merged = true;
                                    break;
                                }
                            }
                            if (!merged) found.add(new int[]{ x, y });
                        }
                    }
                }

                synchronized (BrawlESP.class) { enemies = found; }
                Thread.sleep(16);

            } catch (Exception e) {
                System.err.println("[esp scan err] " + e.getMessage());
            }
        }
    }

    // ── DRAW ────────────────────────────────────────────────────────────────

    void drawESP(Graphics2D g) {
        List<int[]> snapshot;
        synchronized (BrawlESP.class) { snapshot = new ArrayList<>(enemies); }

        for (int[] e : snapshot) {
            int ex = e[0];
            int ey = e[1];

            // Bounding box
            g.setColor(new Color(255, 0, 0, 200));
            g.setStroke(new BasicStroke(2f));
            g.drawRect(ex - BOX_W / 2, ey - BOX_H / 2, BOX_W, BOX_H);

            // Corner brackets
            g.setColor(new Color(255, 255, 0, 230));
            drawCornerBrackets(g, ex - BOX_W / 2, ey - BOX_H / 2, BOX_W, BOX_H, 10);

            // Distance label
            double dist = Math.sqrt(Math.pow(ex - CENTER_X, 2) + Math.pow(ey - CENTER_Y, 2));
            g.setColor(Color.WHITE);
            g.setFont(new Font("Consolas", Font.BOLD, 11));
            g.drawString(String.format("%.0fpx", dist), ex - BOX_W / 2, ey - BOX_H / 2 - 4);

            // Snap line from crosshair
            g.setColor(new Color(255, 50, 50, 120));
            g.setStroke(new BasicStroke(1f));
            g.drawLine(CENTER_X, CENTER_Y, ex, ey);
        }

        // Crosshair
        g.setColor(new Color(0, 255, 0, 180));
        g.setStroke(new BasicStroke(1.5f));
        g.drawLine(CENTER_X - 10, CENTER_Y, CENTER_X + 10, CENTER_Y);
        g.drawLine(CENTER_X, CENTER_Y - 10, CENTER_X, CENTER_Y + 10);

        // HUD
        g.setFont(new Font("Consolas", Font.BOLD, 13));
        g.setColor(new Color(0, 255, 120));
        g.drawString("sourcecodelibbsd.so", 10, 20);
        g.setColor(espActive ? new Color(0, 255, 0) : new Color(255, 60, 60));
        g.drawString("ESP: " + (espActive ? "ON" : "OFF") + "  [F6]", 10, 38);
        g.setColor(Color.WHITE);
        g.drawString("Targets: " + snapshot.size(), 10, 56);
    }

    void drawCornerBrackets(Graphics2D g, int x, int y, int w, int h, int len) {
        // Top-left
        g.drawLine(x, y, x + len, y);
        g.drawLine(x, y, x, y + len);
        // Top-right
        g.drawLine(x + w, y, x + w - len, y);
        g.drawLine(x + w, y, x + w, y + len);
        // Bottom-left
        g.drawLine(x, y + h, x + len, y + h);
        g.drawLine(x, y + h, x, y + h - len);
        // Bottom-right
        g.drawLine(x + w, y + h, x + w - len, y + h);
        g.drawLine(x + w, y + h, x + w, y + h - len);
    }

    // ── COLOR CHECK ─────────────────────────────────────────────────────────

    static boolean isEnemyColor(Color c) {
        return c.getRed()   >= ENEMY_R_MIN && c.getRed()   <= ENEMY_R_MAX
            && c.getGreen() >= ENEMY_G_MIN && c.getGreen() <= ENEMY_G_MAX
            && c.getBlue()  >= ENEMY_B_MIN && c.getBlue()  <= ENEMY_B_MAX;
    }

    // Click-through setup (Java 6 legacy compat)
    static void AWTUtilities_setWindowOpaque(Window w) {
        try {
            Class<?> util = Class.forName("com.sun.awt.AWTUtilities");
            util.getMethod("setWindowOpaque", Window.class, boolean.class)
                .invoke(null, w, false);
        } catch (Exception ignored) {
            // Java 7+ handles this via setBackground(new Color(0,0,0,0)) — already set
        }
    }

    // ── HOTKEYS ─────────────────────────────────────────────────────────────

    static void registerHotkeys() {
        KeyboardFocusManager.getCurrentKeyboardFocusManager()
            .addKeyEventDispatcher(e -> {
                if (e.getID() != KeyEvent.KEY_PRESSED) return false;
                if (e.getKeyCode() == KeyEvent.VK_F6) {
                    espActive = !espActive;
                    System.out.println("[sourcecodelibbsd.so] ESP " + (espActive ? "ON" : "OFF"));
                }
                if (e.getKeyCode() == KeyEvent.VK_F8) System.exit(0);
                return false;
            });
    }

    public static void main(String[] args) throws Exception {
        SwingUtilities.invokeLater(() -> {
            try {
                new BrawlESP();
            } catch (AWTException e) {
                throw new RuntimeException(e);
            }
        });
        registerHotkeys();
    }
}
