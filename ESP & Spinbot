import java.awt.*;
import java.awt.event.*;

public class BrawlSpinbot {

    // ── CONFIG ──────────────────────────────────────────────────────────────
    static final int SCREEN_W  = (int) Toolkit.getDefaultToolkit().getScreenSize().getWidth();
    static final int SCREEN_H  = (int) Toolkit.getDefaultToolkit().getScreenSize().getHeight();
    static final int CENTER_X  = SCREEN_W / 2;
    static final int CENTER_Y  = SCREEN_H / 2;

    static final int    SPIN_RADIUS    = 120;   // px from center — spin circle radius
    static final int    SPIN_STEPS     = 36;    // points on the circle (360/36 = 10° per step)
    static final long   SPIN_DELAY_MS  = 8;     // ms per step — lower = faster spin
    static final float  SPIN_SPEED     = 1.0f;  // multiplier

    static volatile boolean spinActive = false;
    static Robot robot;
    // ────────────────────────────────────────────────────────────────────────

    public static void main(String[] args) throws AWTException {
        robot = new Robot();
        robot.setAutoDelay(0);

        printBanner();
        registerHotkeys();

        //noinspection InfiniteLoopStatement
        while (true) {
            try { Thread.sleep(100); } catch (InterruptedException ignored) {}
        }
    }

    // ── SPIN LOOP ───────────────────────────────────────────────────────────

    static void startSpin() {
        new Thread(() -> {
            double angle = 0;
            double step  = (2 * Math.PI) / SPIN_STEPS * SPIN_SPEED;

            while (spinActive) {
                try {
                    int mx = CENTER_X + (int)(Math.cos(angle) * SPIN_RADIUS);
                    int my = CENTER_Y + (int)(Math.sin(angle) * SPIN_RADIUS);

                    robot.mouseMove(mx, my);
                    angle += step;
                    if (angle >= 2 * Math.PI) angle = 0;

                    Thread.sleep((long)(SPIN_DELAY_MS / SPIN_SPEED));
                } catch (InterruptedException ignored) {}
            }

            // Re-center on stop
            robot.mouseMove(CENTER_X, CENTER_Y);
        }, "spinbot-thread").start();
    }

    // Rage mode — full 360 per frame, maximum disorientation
    static void startRageSpin() {
        new Thread(() -> {
            double angle = 0;
            double step  = (2 * Math.PI) / 8; // 8 points = ultra fast

            while (spinActive) {
                try {
                    int mx = CENTER_X + (int)(Math.cos(angle) * SPIN_RADIUS);
                    int my = CENTER_Y + (int)(Math.sin(angle) * SPIN_RADIUS);

                    robot.mouseMove(mx, my);
                    angle += step;
                    if (angle >= 2 * Math.PI) angle = 0;

                    Thread.sleep(4); // 4ms = ~250 rotations/sec
                } catch (InterruptedException ignored) {}
            }

            robot.mouseMove(CENTER_X, CENTER_Y);
        }, "spinbot-rage-thread").start();
    }

    // ── HOTKEYS ─────────────────────────────────────────────────────────────

    static void registerHotkeys() {
        KeyboardFocusManager.getCurrentKeyboardFocusManager()
            .addKeyEventDispatcher(e -> {
                if (e.getID() != KeyEvent.KEY_PRESSED) return false;

                switch (e.getKeyCode()) {
                    case KeyEvent.VK_F6 -> {
                        spinActive = !spinActive;
                        System.out.println("[sourcecodelibbsd.so] Spinbot " +
                                           (spinActive ? "ON" : "OFF"));
                        if (spinActive) startSpin();
                    }
                    case KeyEvent.VK_F7 -> {
                        spinActive = !spinActive;
                        System.out.println("[sourcecodelibbsd.so] RAGE SPIN " +
                                           (spinActive ? "ON" : "OFF"));
                        if (spinActive) startRageSpin();
                    }
                    case KeyEvent.VK_F8 -> System.exit(0);
                }
                return false;
            });
    }

    // ── BANNER ──────────────────────────────────────────────────────────────

    static void printBanner() {
        System.out.println("""
╔══════════════════════════════════════╗
║   sourcecodelibbsd.so — Spinbot     ║
║   Java Edition                      ║
║   F6  →  Normal spin toggle         ║
║   F7  →  RAGE spin toggle           ║
║   F8  →  Exit                       ║
╚══════════════════════════════════════╝
""");
    }
}
