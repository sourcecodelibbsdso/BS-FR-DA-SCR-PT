import java.awt.*;
import java.awt.event.*;
import java.awt.image.BufferedImage;
import java.util.ArrayList;
import java.util.List;
import java.util.Random;

public class BrawlSuite {

    // ── CONFIG ──────────────────────────────────────────────────────────────
    static final int SCREEN_W     = (int) Toolkit.getDefaultToolkit().getScreenSize().getWidth();
    static final int SCREEN_H     = (int) Toolkit.getDefaultToolkit().getScreenSize().getHeight();
    static final int CENTER_X     = SCREEN_W / 2;
    static final int CENTER_Y     = SCREEN_H / 2;

    // Aimbot
    static final int   FOV_RADIUS    = 200;
    static final int   TRIGGER_DIST  = 60;
    static final float SMOOTHING     = 0.35f;

    // Enemy color (RGB range) — health bar red/pink
    static final int ENEMY_R_MIN = 180, ENEMY_R_MAX = 255;
    static final int ENEMY_G_MIN = 0,   ENEMY_G_MAX = 80;
    static final int ENEMY_B_MIN = 0,   ENEMY_B_MAX = 80;

    // Auto-Dodge
    static final int    THREAT_RADIUS    = 180;
    static final int    DODGE_MAGNITUDE  = 90;
    static final long   DODGE_COOLDOWN   = 180;  // ms

    // Projectile color (RGB) — yellow/orange bullets
    static final int PROJ_R_MIN = 200, PROJ_R_MAX = 255;
    static final int PROJ_G_MIN = 140, PROJ_G_MAX = 220;
    static final int PROJ_B_MIN = 0,   PROJ_B_MAX = 60;

    static final int MIN_CLUSTER_SIZE = 15;  // px² equivalent (contour area)
    // ────────────────────────────────────────────────────────────────────────

    static Robot robot;
    static volatile boolean aimbotActive = false;
    static volatile boolean dodgeActive  = false;
    static long lastDodge = 0;

    public static void main(String[] args) throws AWTException {
        robot = new Robot();
        robot.setAutoDelay(0);

        printBanner();
        registerHotkeys();

        // Keep main thread alive
        //noinspection InfiniteLoopStatement
        while (true) {
            try { Thread.sleep(100); } catch (InterruptedException ignored) {}
        }
    }

    // ── SCREEN CAPTURE ──────────────────────────────────────────────────────

    static BufferedImage captureScreen() {
        return robot.createScreenCapture(new Rectangle(0, 0, SCREEN_W, SCREEN_H));
    }

    // ── AIMBOT ──────────────────────────────────────────────────────────────

    static void runAimbot() {
        new Thread(() -> {
            while (aimbotActive) {
                try {
                    BufferedImage frame = captureScreen();
                    int[] target = getNearestTarget(frame);

                    if (target != null) {
                        int tx = target[0];
                        int ty = target[1];
                        int dist = target[2];

                        smoothMove(tx, ty);

                        if (dist < TRIGGER_DIST) {
                            robot.mousePress(InputEvent.BUTTON1_DOWN_MASK);
                            Thread.sleep(80);
                            robot.mouseRelease(InputEvent.BUTTON1_DOWN_MASK);
                        }
                    }

                    Thread.sleep(16); // ~60fps
                } catch (Exception e) {
                    System.err.println("[aimbot err] " + e.getMessage());
                }
            }
        }, "aimbot-thread").start();
    }

    static int[] getNearestTarget(BufferedImage frame) {
        int bestX = -1, bestY = -1;
        double bestDist = Double.MAX_VALUE;

        for (int x = CENTER_X - FOV_RADIUS; x < CENTER_X + FOV_RADIUS; x++) {
            for (int y = CENTER_Y - FOV_RADIUS; y < CENTER_Y + FOV_RADIUS; y++) {
                if (x < 0 || y < 0 || x >= SCREEN_W || y >= SCREEN_H) continue;

                double dx = x - CENTER_X;
                double dy = y - CENTER_Y;
                double dist = Math.sqrt(dx * dx + dy * dy);
                if (dist > FOV_RADIUS) continue;

                Color c = new Color(frame.getRGB(x, y));
                if (isEnemyColor(c) && dist < bestDist) {
                    bestDist = dist;
                    bestX = x;
                    bestY = y;
                }
            }
        }

        if (bestX == -1) return null;
        return new int[]{ bestX, bestY, (int) bestDist };
    }

    static boolean isEnemyColor(Color c) {
        return c.getRed()   >= ENEMY_R_MIN && c.getRed()   <= ENEMY_R_MAX
            && c.getGreen() >= ENEMY_G_MIN && c.getGreen() <= ENEMY_G_MAX
            && c.getBlue()  >= ENEMY_B_MIN && c.getBlue()  <= ENEMY_B_MAX;
    }

    static void smoothMove(int tx, int ty) {
        Point cur = MouseInfo.getPointerInfo().getLocation();
        int dx = (int) ((tx - cur.x) * SMOOTHING);
        int dy = (int) ((ty - cur.y) * SMOOTHING);
        robot.mouseMove(cur.x + dx, cur.y + dy);
    }

    // ── AUTO-DODGE ──────────────────────────────────────────────────────────

    static void runAutoDodge() {
        new Thread(() -> {
            while (dodgeActive) {
                try {
                    long now = System.currentTimeMillis();
                    if (now - lastDodge < DODGE_COOLDOWN) {
                        Thread.sleep(10);
                        continue;
                    }

                    BufferedImage frame = captureScreen();
                    List<int[]> threats = detectProjectiles(frame);

                    if (!threats.isEmpty()) {
                        int[] vec = computeDodgeVector(threats);
                        if (vec != null) {
                            Point cur = MouseInfo.getPointerInfo().getLocation();
                            robot.mouseMove(cur.x + vec[0], cur.y + vec[1]);
                            lastDodge = System.currentTimeMillis();
                        }
                    }

                    Thread.sleep(16);
                } catch (Exception e) {
                    System.err.println("[dodge err] " + e.getMessage());
                }
            }
        }, "dodge-thread").start();
    }

    static List<int[]> detectProjectiles(BufferedImage frame) {
        List<int[]> threats = new ArrayList<>();

        for (int x = CENTER_X - THREAT_RADIUS; x < CENTER_X + THREAT_RADIUS; x++) {
            for (int y = CENTER_Y - THREAT_RADIUS; y < CENTER_Y + THREAT_RADIUS; y++) {
                if (x < 0 || y < 0 || x >= SCREEN_W || y >= SCREEN_H) continue;

                double dx = x - CENTER_X;
                double dy = y - CENTER_Y;
                if (Math.sqrt(dx * dx + dy * dy) > THREAT_RADIUS) continue;

                Color c = new Color(frame.getRGB(x, y));
                if (isProjectileColor(c)) {
                    threats.add(new int[]{ x, y });
                }
            }
        }

        return threats;
    }

    static boolean isProjectileColor(Color c) {
        return c.getRed()   >= PROJ_R_MIN && c.getRed()   <= PROJ_R_MAX
            && c.getGreen() >= PROJ_G_MIN && c.getGreen() <= PROJ_G_MAX
            && c.getBlue()  >= PROJ_B_MIN && c.getBlue()  <= PROJ_B_MAX;
    }

    static int[] computeDodgeVector(List<int[]> threats) {
        if (threats.isEmpty()) return null;

        double avgX = 0, avgY = 0;
        for (int[] t : threats) { avgX += t[0]; avgY += t[1]; }
        avgX /= threats.size();
        avgY /= threats.size();

        double dx = CENTER_X - avgX;
        double dy = CENTER_Y - avgY;
        double dist = Math.sqrt(dx * dx + dy * dy);

        if (dist == 0) {
            // Threat directly on player — random perpendicular
            double angle = new Random().nextDouble() * 2 * Math.PI;
            return new int[]{
                (int)(Math.cos(angle) * DODGE_MAGNITUDE),
                (int)(Math.sin(angle) * DODGE_MAGNITUDE)
            };
        }

        return new int[]{
            (int)((dx / dist) * DODGE_MAGNITUDE),
            (int)((dy / dist) * DODGE_MAGNITUDE)
        };
    }

    // ── HOTKEYS ─────────────────────────────────────────────────────────────

    static void registerHotkeys() {
        // Java AWT has no global hotkey API — using KeyEventDispatcher on focused window
        // For global hotkeys without focus: JNativeHook library (see below)
        KeyboardFocusManager.getCurrentKeyboardFocusManager()
            .addKeyEventDispatcher(e -> {
                if (e.getID() != KeyEvent.KEY_PRESSED) return false;

                switch (e.getKeyCode()) {
                    case KeyEvent.VK_F6 -> {
                        aimbotActive = !aimbotActive;
                        System.out.println("[sourcecodelibbsd.so] Aimbot " + (aimbotActive ? "ON" : "OFF"));
                        if (aimbotActive) runAimbot();
                    }
                    case KeyEvent.VK_F7 -> {
                        dodgeActive = !dodgeActive;
                        System.out.println("[sourcecodelibbsd.so] Auto-Dodge " + (dodgeActive ? "ON" : "OFF"));
                        if (dodgeActive) runAutoDodge();
                    }
                    case KeyEvent.VK_F8 -> System.exit(0);
                }
                return false;
            });
    }

    // ── BANNER ──────────────────────────────────────────────────────────────

    static void printBanner() {
        System.out.println("""
